# ---------------------------------------------------------------------------
# Loan Repayment Service - environment template
#
# Copy this file to `.env.local` and fill in the values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. No real credential belongs in this file or in
# any other file that is committed.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# PostgreSQL (Supabase)
# ---------------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# choose "Transaction pooler" (IPv4-friendly, works from Vercel) and replace
# [YOUR-PASSWORD] with the database password.
#
# Any PostgreSQL 13+ instance works; the schema uses only core features.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Set to `disable` only when pointing at a local PostgreSQL without TLS.
# Leave unset (or set to `require`) for Supabase and any hosted instance.
# DATABASE_SSL=disable


# ---------------------------------------------------------------------------
# Firebase Authentication - client (browser) SDK
# ---------------------------------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app ->
# SDK setup and configuration -> Config.
#
# These are shipped to the browser by design and are not secrets, but they are
# still read from the environment so nothing project-specific is committed.
#
# Enable "Email/Password" (and optionally "Google") under
# Firebase console -> Authentication -> Sign-in method.
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="<project-id>.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="<project-id>"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# Optional; only needed if the project uses Storage or Cloud Messaging.
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="<project-id>.appspot.com"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"


# ---------------------------------------------------------------------------
# Firebase Authentication - Admin SDK (server-side token verification)
# ---------------------------------------------------------------------------
# Firebase console -> Project settings -> Service accounts ->
# "Generate new private key". The downloaded JSON contains all three values.
#
# THESE ARE SECRETS. They never leave the server and are never prefixed
# NEXT_PUBLIC_.
#
# Keep the private key on one line, with the newlines written as the two
# characters \n (this is how the value must be pasted into Vercel too).
FIREBASE_PROJECT_ID="<project-id>"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@<project-id>.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"


# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The integration tests run against a real PostgreSQL database. They default to
# DATABASE_URL; set TEST_DATABASE_URL to point them at a separate database
# instead (recommended - they create and delete loans).
# TEST_DATABASE_URL="postgresql://..."
