{
  "name": "loan_repayment_service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "//": "firebase-admin@14 requires Node >=22, and it reaches jose@6 (pure ESM) through jwks-rsa via require(). require() of an ES module is only unflagged from Node 22.12, so anything older throws ERR_REQUIRE_ESM at runtime. Vercel reads this field to pick the function runtime.",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "vercel-build": "tsx scripts/db-setup.ts --skip-if-unconfigured && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
